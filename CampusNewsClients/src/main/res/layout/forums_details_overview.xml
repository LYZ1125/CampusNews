<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:id="@+id/forums_details_itemlayout1"
        android:visibility="visible"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!--第1行-->
        <LinearLayout
            android:visibility="invisible"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:background="#3ee3a004"
                android:layout_width="180dp"
                android:layout_height="match_parent">
                <TextView
                    android:padding="30dp"
                    android:textSize="20sp"
                    android:text="军事"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="20dp"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:background="#48eb0d"
                android:layout_marginRight="30dp"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                >
                <TextView
                    android:padding="30dp"
                    android:textSize="20sp"
                    android:text="军事"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>



        </LinearLayout>
        <!--第2行-->

        <LinearLayout
            android:layout_marginTop="5dp"

            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/framelayoute21"
                android:background="#9940de5a"
                android:layout_marginLeft="30dp"
                android:layout_width="0dp"
                android:layout_weight="4"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="40dp"
                    android:text="军事"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="10dp"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/framelayoute22"

                android:background="#99ffd71b"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="match_parent">
                <TextView
                    android:padding="40dp"
                    android:textSize="30sp"
                    android:text="经济"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>


        </LinearLayout>
        <!--第3行-->

        <LinearLayout
            android:layout_marginTop="5dp"

            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/framelayoute31"

                android:background="#9acc99cc"

                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="match_parent">
                <TextView
                    android:padding="40dp"
                    android:textSize="30sp"
                    android:text="文化"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="10dp"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/framelayoute32"

                android:background="#984e6cef"
                android:layout_marginRight="30dp"

                android:layout_width="0dp"
                android:layout_weight="4"
                android:layout_height="match_parent">
                <TextView
                    android:padding="40dp"
                    android:textSize="30sp"
                    android:text="政治"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>


        </LinearLayout>
        <!--第4行-->
        <LinearLayout
            android:visibility="invisible"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:background="#48eb0d"
                android:layout_marginLeft="30dp"
                android:layout_width="140dp"
                android:layout_height="match_parent">
                <TextView
                    android:padding="40dp"
                    android:textSize="30sp"
                    android:text="军事"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="20dp"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:background="#e3a004"
                android:layout_width="180dp"
                android:layout_height="match_parent">
                <TextView
                    android:padding="30dp"
                    android:textSize="20sp"
                    android:text="军事"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>


        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/forums_details_itemlayout2"
        android:visibility="visible"
        android:padding="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:id="@+id/btn_back_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="#9cfffff0"
            android:src="@drawable/btn_back_detail_normal"/>
        <LinearLayout
            android:background="#9cfffff0"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:text="请选择具体角度："
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="10dp"
                android:textSize="20sp"
                android:textColor="#00a0e9"
                android:id="@+id/background"
                />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginLeft="17dp"
                android:layout_marginRight="17dp"
                android:hint="最多四个角度"
                android:textSize="20dp"
                android:gravity="center"

                android:textAlignment="center"
                android:id="@+id/tag_edit" />

            <android.support.design.widget.FloatingActionButton
                android:id="@+id/adding_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="#66ccff"
                app:fabSize="mini"
                android:layout_marginLeft="@dimen/widget_margin"
                android:src="@drawable/details_floating_adding_btn"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/widget_margin">
                  <GridLayout
                    android:id="@+id/forums_details_grid_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="1"
                    android:layoutAnimation="@anim/layout_alpha_in">

                  </GridLayout>
        <GridLayout
            android:id="@+id/forums_details_grid_second"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:layoutAnimation="@anim/layout_alpha_in">

        </GridLayout>
        <GridLayout
            android:id="@+id/forums_details_grid_third"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:layoutAnimation="@anim/layout_alpha_in">

        </GridLayout>
        <GridLayout
            android:id="@+id/forums_details_grid_fourth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:layoutAnimation="@anim/layout_alpha_in">

        </GridLayout>
        <GridLayout
            android:id="@+id/forums_details_grid_fifth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:layoutAnimation="@anim/layout_alpha_in">

        </GridLayout>
            </LinearLayout>

        </LinearLayout>
        <TextView
            android:id="@+id/begin_discussion"
            android:textSize="20sp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:textColor="#00a0e9"
            android:text="开启我的BB之旅"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>




</RelativeLayout>